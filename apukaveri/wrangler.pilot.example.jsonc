{
  "name": "apukaveri-closed-pilot",
  "main": "server/cloud.mjs",
  "compatibility_date": "2026-05-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {"pattern": "pilot.example.invalid", "custom_domain": true}
  ],
  "assets": {
    "directory": "./server-build",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {
    "MODE": "closed-pilot",
    "PILOT_HOST": "pilot.example.invalid",
    "ACCESS_ISSUER": "https://replace-me.cloudflareaccess.com",
    "ACCESS_AUDIENCE": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "apukaveri-closed-pilot",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "server/migrations"
    }
  ]
}
